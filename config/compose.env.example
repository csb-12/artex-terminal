# 复制为 config/.compose.env，或运行：
#   python scripts/bootstrap-terminal-agent.py --init
#
# Docker Desktop 要正斜杠路径。不要把 .compose.env 提交进 Git。

ERKA_ROOT=C:/path/to/artex-terminal

# 可选：你的 ARTEX 安装目录（文档里的 %ARTEX_HOME%）
# ARTEX_HOME=C:/path/to/ARTEX

# 可选：Grok 桥 auth（named volume / C: 联接 workaround 才需要）
# GROK_AUTH_JSON=C:/Users/you/.grok/auth.json

# 可选：Windows virtiofs 走 C: NTFS 联接时
# ARTEX_BIND=C:/Users/you/artex-bind
# ERKA_BIND=C:/Users/you/erka-bind
